#!/bin/bash
# Translate the current text selection in the Omarchy overlay
# (plugin io.github.terrerovgh.translate-selection). Bind it to a key, e.g. SUPER+ALT+T.
#
# The selection is not read here: the plugin reads it with wl-paste through a
# pipe, so the text never appears in any process's command line.

exec omarchy-shell -q shell summon io.github.terrerovgh.translate-selection '{"source":"selection"}'
